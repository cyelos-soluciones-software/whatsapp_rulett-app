# PostgreSQL — misma BD que rulett.app (Neon en prod, local en dev)
# En Neon usa la URL externa (no localhost). Quita ?schema=public si la copiaste de Prisma.
DATABASE_URL=postgresql://rulett_admin:rulett_secure_password_local@localhost:5440/rulett_db

# Lote por disparo (el build de Cloud Run no hace sondeo: POLL_INTERVAL_MS solo lo usa el build de Render)
BATCH_SIZE=50

# HTTP (Render y Cloud Run asignan PORT automáticamente)
PORT=8080
WORKER_API_KEY=secreto_largo_aleatorio

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=1064133880126015
WHATSAPP_ACCOUNT_ID=868325479011642
WHATSAPP_LANGUAGE_CODE=es_CO

# Plantillas v2 con botón «Información del comercio» (056)
# Índice base 0 del botón; debe coincidir con el orden aprobado en Meta (default 1)
WHATSAPP_V2_BUTTON_INDEX=1
# Opcional: solo si Meta registra la variable de la URL con nombre; sin definir va posicional
# WHATSAPP_V2_BUTTON_PARAM_NAME=boton_comercio

# Local: false | Neon/Render: true (si usas neon.tech se infiere solo)
DATABASE_SSL=false

# Opcional: forzar IDs en el seed (si no, se resuelven desde la BD)
# SEED_TENANT_ID=
# SEED_QR_CAMPAIGN_ID=
